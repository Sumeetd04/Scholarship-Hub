# Copy to .env and adjust for your machine.
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@scholarshiphub.in
ADMIN_PASSWORD=Admin@123

# Where the SQLite file lives (defaults to ./data/scholarship_hub.db)
# SCHOLARSHIP_DB=/absolute/path/to/scholarship_hub.db

# Session lifetime in hours
TOKEN_TTL_HOURS=168

# Set to 1 when serving over HTTPS
COOKIE_SECURE=0
